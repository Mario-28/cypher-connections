{{!--
  Item Tooltip Template
  Dark card tooltip displayed on item hover.
  Context: { item, typeData }
--}}
<div class="connection-tooltip item-tooltip" data-item-id="{{item.id}}">
  <div class="tooltip-header" style="border-color: {{typeData.color}};">
    <div class="tooltip-icon" style="background-color: {{typeData.color}}20; border-color: {{typeData.color}};">
      {{#if item.img}}
        <img src="{{item.img}}" alt="{{item.name}}" />
      {{else}}
        <i class="fas {{typeData.defaultIcon}}" style="color: {{typeData.color}};"></i>
      {{/if}}
    </div>
    <div class="tooltip-title">
      <h4 style="color: {{typeData.color}};">{{item.name}}</h4>
      <span class="type-badge" style="background-color: {{typeData.color}}20; color: {{typeData.color}};">
        {{typeData.label}}
      </span>
    </div>
  </div>

  {{#if item.description}}
    <div class="tooltip-body">
      <div class="tooltip-description">{{item.description}}</div>
    </div>
  {{/if}}

  <div class="tooltip-footer">
    <span class="hint">{{localize "CYPHERCONNECTIONS.ItemTooltipHint"}}</span>
  </div>
</div>
